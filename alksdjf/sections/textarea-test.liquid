{% schema %}
{
  "name": "Textarea (Test)",
  "settings": [
    {
      "type": "text",
      "id": "name",
      "label": "Feldname"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Beschriftung"
    },
    {
      "type": "text",
      "id": "value",
      "label": "Vorbef\u00fcllter Text"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Platzhalter"
    },
    {
      "type": "number",
      "id": "rows",
      "label": "Anzahl Zeilen"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Hilfetext"
    },
    {
      "type": "text",
      "id": "error",
      "label": "Fehlermeldung"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Pflichtfeld"
    },
    {
      "type": "checkbox",
      "id": "disabled",
      "label": "Deaktiviert"
    },
    {
      "type": "number",
      "id": "maxlength",
      "label": "Maximale L\u00e4nge"
    },
    {
      "type": "text",
      "id": "id",
      "label": "HTML-ID"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Textarea (Test)"
    }
  ]
}
{% endschema %}

<div class="textarea-test">
  {% render 'alksdjf/snippets/textarea',
  name: section.settings.name,
  label: section.settings.label,
  value: section.settings.value,
  placeholder: section.settings.placeholder,
  rows: section.settings.rows,
  helper_text: section.settings.helper_text,
  error: section.settings.error,
  required: section.settings.required,
  disabled: section.settings.disabled,
  maxlength: section.settings.maxlength,
  id: section.settings.id
%}
</div>
