{%- comment -%}
  Snippet: button
  Verwendung: {% render 'button', label: 'Jetzt kaufen', url: routes.cart_url %}
  Parameter:
    - label: Button-Text (text, 'Button')
    - url: Link-Ziel (url, '#')
    - style: Button-Variante: primary | secondary | tertiary (text, 'primary')
    - size: Größenvariante: sm | md | lg (text, 'md')
    - icon: Icon-Name für {% render 'icon' %} (text, nil)
    - icon_position: Position des Icons: left | right (text, 'left')
    - type: Button-Type für <button> (text, 'button')
    - is_disabled: Deaktiviert den Button (boolean, false)
    - aria_label: Überschreibt das aria-label (text, nil)
    - id: HTML-ID (text, nil)
    - form: Formular-ID für Button-Submit (text, nil)
    - target_blank: Öffnet Link in neuem Tab (boolean, false)
    - size_styles: Zusätzliche Inline-Styles für Größen (text, nil)
    - border_width: Rahmenbreite in px (text, nil)
    - border_radius: Rahmenradius in px (text, nil)
    - border_style: Rahmenstil (text, nil)
{%- endcomment -%}

{%- liquid
  assign label = label | default: 'Button'
  assign url = url | default: '#'
  assign style = style | default: 'primary'
  assign size = size | default: 'md'
  assign icon_position = icon_position | default: 'left'
  assign type = type | default: 'button'
  assign is_disabled = is_disabled | default: false
  assign aria_label = aria_label | default: label
  assign id = id | default: nil
  assign form = form | default: nil
  assign target_blank = target_blank | default: false
  assign size_styles = size_styles | default: nil
  assign border_width = border_width | default: nil
  assign border_radius = border_radius | default: nil
  assign border_style = border_style | default: nil
  assign escaped_aria = aria_label | escape
  assign escaped_id = id | escape
  assign escaped_form = form | escape
  assign escaped_type = type | escape
  assign escaped_size = size | escape
  assign escaped_style = style | escape

  assign disabled_flag = is_disabled == true or is_disabled == 'true'
  assign is_link = url and disabled_flag != true

  assign tag = 'a'
  assign resolved_link = url
  if is_link != true and is_link != 'true'
    assign tag = 'button'
    assign resolved_link = nil
  endif

  assign variant_mapping = {
    'primary': 'button',
    'secondary': 'button-secondary',
    'tertiary': 'button-tertiary'
  }
  assign button_variant = variant_mapping[style]
  if button_variant == blank
    assign button_variant = 'button'
  endif

  assign context_id = id
  if context_id == blank
    assign context_id = 'button'
  endif

  assign attribute_parts = ''
  if id != blank
    assign attribute_parts = attribute_parts | append: ' id="' | append: escaped_id | append: '"'
  endif
  if tag == 'button'
    assign attribute_parts = attribute_parts | append: ' type="' | append: escaped_type | append: '"'
    if form != blank
      assign attribute_parts = attribute_parts | append: ' form="' | append: escaped_form | append: '"'
    endif
  endif
  if disabled_flag
    assign attribute_parts = attribute_parts | append: ' aria-disabled="true"'
    if tag == 'button'
      assign attribute_parts = attribute_parts | append: ' disabled'
    else
      assign resolved_link = nil
    endif
  endif
  assign attribute_parts = attribute_parts | append: ' aria-label="' | append: escaped_aria | append: '"'
  assign attribute_parts = attribute_parts | append: ' data-button-size="' | append: escaped_size | append: '"'
  assign attribute_parts = attribute_parts | append: ' data-button-style="' | append: escaped_style | append: '"'
-%}

{% render 'alksdjf/snippets/button',
  tag: tag,
  id: context_id,
  label: label,
  link: resolved_link,
  variant: button_variant,
  open_in_new_tab: target_blank,
  shopify_attributes: attribute_parts,
  size_styles: size_styles,
  icon: icon,
  icon_position: icon_position,
  border_width: border_width,
  border_radius: border_radius,
  border_style: border_style
%}
